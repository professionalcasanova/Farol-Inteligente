                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Orcamento familia enxuto\",\n  \"description\": \"Modelo simples para organizar gastos essenciais.\",\n  \"targetProfile\": \"Casal com um filho\",\n  \"monthlyIncomeReference\": 4200,\n  \"isPublic\": true,\n  \"items\": [\n    {\n      \"name\": \"Aluguel\",\n      \"categoryName\": \"Moradia\",\n      \"type\": \"expense\",\n      \"allocationType\": \"fixed_amount\",\n      \"amount\": 1200,\n      \"percentage\": null,\n      \"notes\": null,\n      \"sortOrder\": 1\n    },\n    {\n      \"name\": \"Reserva\",\n      \"categoryName\": \"Reserva\",\n      \"type\": \"reserve\",\n      \"allocationType\": \"percentage\",\n      \"amount\": null,\n      \"percentage\": 10,\n      \"notes\": \"Guardar no inicio do mes.\",\n      \"sortOrder\": 2\n    }\n  ],\n  \"status\": \"published\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/community-budgets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "community-budgets"
              ]
            }
