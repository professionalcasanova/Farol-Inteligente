{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=farol;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "Farol.Api",
    "Audience": "Farol.Client",
    "SigningKey": "farol-default-signing-key-change-in-production-12345"
