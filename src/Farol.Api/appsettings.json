      "Host": "localhost",
      "Port": 1025,
      "UseTls": false,
      "Username": "",
      "Password": ""
    },
    "Resend": {
      "ApiUrl": "https://api.resend.com/emails",
      "ApiKey": "",
      "TimeoutSeconds": 10
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
